# Rename this file to deploy/.env and fill in real values.

# --- Database (internal to the stack; defaults match compose) ---
POSTGRES_USER=eddms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enrolment_db
DATABASE_URL=postgresql+asyncpg://eddms:change-me@db:5432/enrolment_db

# --- Clerk (Production instance keys) ---
CLERK_SECRET_KEY=sk_live_...
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----..."
# Origin where the frontend is served; merged with built-in localhost defaults.
CLERK_AUTHORIZED_PARTIES=http://<server-ip>:80

# --- Frontend build (baked in at build time) ---
# Empty = same-origin: the browser talks to nginx on the same host, no CORS/rebuild on IP change.
VITE_API_BASE_URL=
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# --- Google Cloud (values mirror backend/.env) ---
GOOGLE_CLOUD_PROJECT=weighty-rookery-t3bf2
GCS_BUCKET=enrolment-documents-weighty-rookery-t3bf2-asia-southeast1
GOOGLE_CLOUD_LOCATION=asia-southeast1
VERTEX_AI_MODEL=gemini-2.5-flash
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json
# Full origin including scheme and port (no trailing slash).
CORS_ORIGINS=http://<server-ip>:80
GCS_CORS_ORIGINS=http://<server-ip>:80
# Optional: GCS_STAGING_PREFIX=staging/
# Optional: GCS_PRODUCTION_PREFIX=production/

# --- Service account JSON on the HOST ---
# Path (relative to deploy/) of the service-account JSON mounted into backend.
SA_HOST_PATH=./gcp-credentials/vertex-ai-service-account.json