# Clerk (server-side)
CLERK_SECRET_KEY=
CLERK_JWT_KEY=

# Database (use either DATABASE_URL or the DB_* parts)
DATABASE_URL=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enrollment_docs

# Dev toggles
AUTO_CREATE_TABLES=false
DEBUG_CLAIMS=false

# Google Cloud Storage
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET=
GCS_STAGING_PREFIX=staging/
GCS_PRODUCTION_PREFIX=production/
GCS_ADMIN_TEMP_PREFIX=admin-temp/
GCS_CORS_ORIGINS=http://localhost:5173

# Google Cloud Location
GOOGLE_CLOUD_LOCATION=asia-southeast1

# Vertex AI Gemini
VERTEX_AI_MODEL=gemini-2.5-flash
