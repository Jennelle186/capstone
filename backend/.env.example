# Clerk (server-side)
CLERK_SECRET_KEY=
CLERK_JWT_KEY=

# Database (use either DATABASE_URL or the DB_* parts)
DATABASE_URL=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enrollment_docs

# Dev toggles
AUTO_CREATE_TABLES=false
DEBUG_CLAIMS=false

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET=
S3_STAGING_PREFIX=staging/
S3_PRODUCTION_PREFIX=production/